/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // --- Simulation ---
    withName: 'SIMULATE_MIDASIM' {
        publishDir = [ path: { "${params.sim_outdir}" }, mode: 'copy', overwrite: true ]
    }

    // --- Extract control ---
    withName: 'EXTRACT_CONTROL' {
        publishDir = [ path: { "${params.outdir}/control_extract" }, mode: 'copy', overwrite: true ]
    }

    // --- DA tools (simulated) ---
    withName: 'ADAPT' {
        publishDir = [ path: { "${params.outdir}/da_tools/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'CORNCOB' {
        publishDir = [ path: { "${params.outdir}/da_tools/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'LINDA' {
        publishDir = [ path: { "${params.outdir}/da_tools/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'LOCOM' {
        publishDir = [ path: { "${params.outdir}/da_tools/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'MAASLIN2' {
        publishDir = [ path: { "${params.outdir}/da_tools/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'METAGENOMESEQ' {
        publishDir = [ path: { "${params.outdir}/da_tools/${rep_id}" }, mode: 'copy', overwrite: true ]
    }

    // --- Scoring ---
    withName: 'DA_SCORING' {
        publishDir = [ path: { "${params.outdir}/da_scoring" }, mode: 'copy', overwrite: false ]
    }

    // --- DA tools (real) ---
    withName: 'ADAPT_REAL' {
        publishDir = [ path: { "${params.outdir}/da_tools_real/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'CORNCOB_REAL' {
        publishDir = [ path: { "${params.outdir}/da_tools_real/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'LINDA_REAL' {
        memory = '24 GB'
        maxForks = 1
        publishDir = [ path: { "${params.outdir}/da_tools_real/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'LOCOM_REAL' {
        publishDir = [ path: { "${params.outdir}/da_tools_real/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'MAASLIN2_REAL' {
        publishDir = [ path: { "${params.outdir}/da_tools_real/${rep_id}" }, mode: 'copy', overwrite: true ]
    }
    withName: 'METAGENOMESEQ_REAL' {
        publishDir = [ path: { "${params.outdir}/da_tools_real/${rep_id}" }, mode: 'copy', overwrite: true ]
    }

    // --- Weighted consensus ---
    withName: 'APPLY_WEIGHTED_CONSENSUS' {
        publishDir = [ path: { "${params.outdir}/weighted_consensus" }, mode: 'copy', overwrite: true ]
    }

    // --- K-intersection (Path A) ---
    withName: 'K_INTERSECTION' {
        publishDir = [ path: { "${params.outdir}/k_intersection" }, mode: 'copy', overwrite: true ]
    }
}
